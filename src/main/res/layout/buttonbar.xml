<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buttonbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/buttonbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/artisttab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/tab_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/browse_menu"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/tab_text_color"
            app:drawableTopCompat="@drawable/ic_tab_artists"
            app:drawableTint="@color/tab_icon_tint"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/albumtab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/tab_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/albums_menu"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/tab_text_color"
            app:drawableTopCompat="@drawable/ic_tab_albums"
            app:drawableTint="@color/tab_icon_tint"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/songtab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/tab_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tracks_menu"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/tab_text_color"
            app:drawableTopCompat="@drawable/ic_tab_songs"
            app:drawableTint="@color/tab_icon_tint"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/playlisttab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/tab_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/playlists_menu"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/tab_text_color"
            app:drawableTopCompat="@drawable/ic_tab_playlists"
            app:drawableTint="@color/tab_icon_tint"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/nowplayingtab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/overflow_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_overflow"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
